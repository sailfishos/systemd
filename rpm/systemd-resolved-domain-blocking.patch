+static int bus_method_reload_block_lists(sd_bus_message *message, void *userdata, sd_bus_error *error) {
+        Manager *m = userdata;
+        int r;
+
+        assert(message);
+        assert(m);
+
+        /* v238's bus_open_system_watch_bind() marks the bus trusted, bypassing vtable access checks. */
+        r = sd_bus_query_sender_privilege(message, CAP_SYS_ADMIN);
+        if (r < 0)
+                return r;
+        if (r == 0)
+                return sd_bus_error_setf(error, SD_BUS_ERROR_ACCESS_DENIED, "Access to ReloadBlockLists() not permitted.");
+
+        r = dns_blocklist_reload(m->blocked_domain_files, false, &m->blocked_domains);
+        if (r < 0) {
+                log_warning_errno(r, "Failed to reload blocked domain files, keeping the active lists: %m");
+                return sd_bus_error_set_errnof(error, r, "Failed to reload blocked domain files: %m");
+        }
+
+        return sd_bus_reply_method_return(message, NULL);
+}
+
